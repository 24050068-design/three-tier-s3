# Database mà backend kết nối tới (Docker dùng qua env_file, `python main.py` dùng qua load_dotenv).
# Dùng RDS: điền endpoint RDS như dưới.
# Dùng MySQL container local: DB_HOST=db, DB_PORT=3306, DB_USER=todo_user, DB_PASSWORD=todo_pass
#   và chạy `docker compose --profile local up -d`
DB_HOST=db.cnwk62euyuch.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=todo_pass

# S3: nơi backend lưu và đọc ảnh. Đổi bucket thì sửa ở đây rồi chạy lại `docker compose up -d`.
# EC2 cần gắn IAM Role có s3:ListBucket trên bucket và s3:GetObject/PutObject/DeleteObject trên thư mục ảnh.
# Bỏ trống S3_BUCKET = tắt phần ảnh.
S3_BUCKET=bdu-s3-ec2-buckets
S3_PREFIX=anh/
AWS_REGION=ap-southeast-1
# URL dịch vụ S3 (phải cùng region với bucket). Bỏ trống = https://s3.<AWS_REGION>.amazonaws.com
S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
